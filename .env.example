# Copy to .env.local and fill in. Never commit .env.local.

# Supabase case store. Keep the database password and full connection URI server-side.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_CA_FILE=

# Clio developer app (Clio Manage: Settings -> Developer Applications). Pick read-only permissions.
CLIO_BASE_URL=https://app.clio.com
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_REDIRECT_URI=http://127.0.0.1:3000/auth/clio/callback

# Claude API key for the digest pipeline (console.anthropic.com)
ANTHROPIC_API_KEY=
